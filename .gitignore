# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data — raw files are large, do not commit
data/raw/udise/*
data/raw/nfhs/*
data/raw/mgnrega/*
data/raw/boundaries/*
data/raw/additional/*
!data/raw/**/.gitkeep

# Intermediate and processed outputs (regenerated by pipeline)
data/interim/*
!data/interim/.gitkeep
!data/processed/*.parquet
!data/processed/.gitkeep

# Metadata (regenerated)
data/metadata/*
!data/metadata/.gitkeep

# Model artifacts
models/*.pkl
models/*.joblib
models/*.json
!models/.gitkeep
data/models/*
!data/models/.gitkeep

# Reports (generated)
reports/*
!reports/.gitkeep

# OS
.DS_Store
Thumbs.db
desktop.ini

# Streamlit
.streamlit/secrets.toml
